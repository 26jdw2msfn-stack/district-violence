    <!-- PERKS -->
    <section class="block" id="perks" style="background: var(--bg-panel);">
      <div class="container">
        <div class="block-head reveal">
          <div>
            <span class="eyebrow">Perk Intel</span>
            <h2>Three survivor perks<br/>that actually carry</h2>
          </div>
          <p>Every perk has three levels — yellow, green, red. Here are three that show up in almost every winning loadout.</p>
        </div>

        <div class="perks-grid-3 reveal">
          <div class="perk-show">
            <span class="tier-badge">S Tier</span>
            <h3>Absolute Confidence</h3>
            <p class="pdesc-main">While in a chase, every survivor within 180 studs works faster and glows to you. Team-wide awareness, no cost.</p>
            <div class="levels">
              <div class="lvl l1">3% SPEED</div>
              <div class="lvl l2">5% SPEED</div>
              <div class="lvl l3">7% SPEED</div>
            </div>
            <p class="flavor">"Ladies, I've got this."</p>
          </div>

          <div class="perk-show">
            <span class="tier-badge">S Tier</span>
            <h3>Built Different</h3>
