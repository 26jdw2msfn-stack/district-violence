---
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DISTRICT VIOLENCE — Community Companion</title>
    <meta name="description" content="District Violence community companion: killers, perks, items, patch notes, and playstyle quiz. One killer. Five survivors. Five generators." />
    <link rel="canonical" href="https://district-violence.sherstiukmark.workers.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="District Violence Community Hub" />
    <meta property="og:title" content="District Violence — Community Companion" />
    <meta property="og:description" content="One killer. Five survivors. Five generators to escape. Killer dossiers, perk intel, a 1:1 skill-check trainer, and straight answers — no clickbait." />
    <meta property="og:url" content="https://district-violence.sherstiukmark.workers.dev/" />
    <meta property="og:image" content="https://district-violence.sherstiukmark.workers.dev/hero-bg.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="District Violence — Community Companion" />
    <meta name="twitter:description" content="One killer. Five survivors. Five generators to escape. Killer dossiers, perk intel, a 1:1 skill-check trainer, and straight answers." />
    <meta name="twitter:image" content="https://district-violence.sherstiukmark.workers.dev/hero-bg.jpg" />
    <link rel="icon" type="image/webp" href="vd-logo.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=JetBrains+Mono:wght@400;500;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      /* === TOKENS === */
      :root {
        --bg-deep: #0a0a0a;
        --bg-panel: #121212;
        --bg-card: #181818;
        --bg-card-hover: #1d1d1d;
        --text-primary: #f4f4f4;
        --text-secondary: #a6a6a6;
        --text-muted: #8a8a8a;
        --accent: #e61919;
        --accent-red-glow: rgba(230, 25, 25, 0.45);
        --accent-green: #4ade80;
        --accent-amber: #fbbf24;
        --border-hairline: rgba(255, 255, 255, 0.07);
        --border-strong: rgba(255, 255, 255, 0.14);
        --font-display: 'Archivo Black', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --font-body: 'Manrope', system-ui, sans-serif;
        --ease-fluid: cubic-bezier(0.32, 0.72, 0, 1);
        --ease-out-back: cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }

      body {
        background: var(--bg-deep);
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.6;
        overflow-x: hidden;
        position: relative;
      }

      /* === CRT OVERLAY === */
      body::before {
        content: '';
        position: fixed; inset: 0; pointer-events: none; z-index: 9999;
        background: repeating-linear-gradient(0deg, transparent 0, transparent 2px, rgba(0,0,0,0.18) 2px, rgba(0,0,0,0.18) 3px);
        opacity: 0.6;
      }
      body::after {
        content: '';
        position: fixed; inset: 0; pointer-events: none; z-index: 9998;
        background: radial-gradient(ellipse at center, transparent 50%, rgba(0,0,0,0.55) 100%);
      }

      ::-webkit-scrollbar { width: 10px; }
      ::-webkit-scrollbar-track { background: var(--bg-deep); }
      ::-webkit-scrollbar-thumb { background: #2a2a2a; border-radius: 5px; border: 2px solid var(--bg-deep); }
      ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

      .display { font-family: var(--font-display); letter-spacing: -0.02em; line-height: 0.95; }
      .mono { font-family: var(--font-mono); }
      .eyebrow {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--accent);
        padding: 4px 12px;
        border: 1px solid var(--accent);
        border-radius: 999px;
        background: rgba(230, 25, 25, 0.08);
      }

      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }

      .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

      /* === NAV === */
      nav {
        position: fixed;
        top: 24px; left: 50%;
        transform: translateX(-50%);
        z-index: 1000;
        background: rgba(10, 10, 10, 0.7);
        backdrop-filter: blur(24px) saturate(1.4);
        -webkit-backdrop-filter: blur(24px) saturate(1.4);
        border: 1px solid var(--border-hairline);
        border-radius: 999px;
        padding: 8px 8px 8px 20px;
        display: flex; align-items: center; gap: 20px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
      }
      .nav-logo { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-size: 1.1rem; letter-spacing: 0.04em; }
      .nav-logo img { width: 30px; height: 30px; border-radius: 6px; }
      .nav-logo .vd-dot { color: var(--accent); }
      .nav-links { display: flex; align-items: center; gap: 2px; }
      .nav-links a {
        font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em;
        text-transform: uppercase; color: var(--text-secondary);
        padding: 8px 11px; border-radius: 999px;
        transition: all 0.4s var(--ease-fluid);
      }
      .nav-links a:hover { color: var(--text-primary); background: rgba(255,255,255,0.05); }
      .nav-cta {
        font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em;
        text-transform: uppercase; padding: 10px 18px; border-radius: 999px;
        background: var(--accent); color: #fff;
        display: flex; align-items: center; gap: 8px;
        transition: all 0.4s var(--ease-fluid);
        box-shadow: 0 0 0 0 var(--accent-red-glow);
      }
      .nav-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 24px var(--accent-red-glow); }
      .nav-cta svg { width: 12px; height: 12px; fill: currentColor; }
      @media (max-width: 1080px) { .nav-links { display: none; } }

      /* === HERO === */
      .hero { min-height: 100dvh; position: relative; display: flex; align-items: center; overflow: hidden;
        /* The fog beam only tracks left/right. Letting the browser keep vertical
           pan keeps the page scrollable on phones; without this, a downward drag
           is seized as a scroll and the pointer is cancelled mid-gesture. */
        touch-action: pan-y; }
      .hero-bg { position: absolute; inset: 0; background: url('/hero-bg.jpg') center center / cover no-repeat; }
      .hero-bg::before {
        content: ''; position: absolute; inset: 0;
        background:
          linear-gradient(180deg, rgba(10,10,10,0.65) 0%, rgba(10,10,10,0.4) 30%, rgba(10,10,10,0.95) 85%, rgba(10,10,10,1) 100%),
          linear-gradient(90deg, rgba(10,10,10,0.8) 0%, transparent 50%, rgba(10,10,10,0.8) 100%);
      }
      .hero-bg::after {
        content: ''; position: absolute; inset: 0;
        background: repeating-linear-gradient(0deg, transparent 0, transparent 3px, rgba(0,0,0,0.08) 3px, rgba(0,0,0,0.08) 4px);
        mix-blend-mode: multiply;
      }
      .hero-content { position: relative; z-index: 2; padding-top: 120px; padding-bottom: 80px; width: 100%; }
      .hero-meta-row {
        display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
        margin-bottom: 28px;
        font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--text-secondary);
      }
      .status-pill {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 6px 14px; border-radius: 999px;
        background: rgba(74, 222, 128, 0.1); border: 1px solid rgba(74, 222, 128, 0.3);
        color: var(--accent-green);
      }
      .status-pill .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-green); box-shadow: 0 0 8px var(--accent-green); animation: pulse 2s ease-in-out infinite; }
      @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }
      .hero-title { font-size: clamp(3.5rem, 12vw, 9rem); text-transform: uppercase; color: #fff; text-shadow: 0 0 40px rgba(230,25,25,0.35), 0 4px 30px rgba(0,0,0,0.7); margin-bottom: 8px; }
      .hero-title .stroke { color: transparent; -webkit-text-stroke: 1.5px rgba(230, 25, 25, 0.65); }
      .hero-sub { font-size: clamp(0.95rem, 1.6vw, 1.15rem); color: var(--text-secondary); max-width: 640px; margin-bottom: 40px; font-weight: 500; }
      .play-giant {
        display: inline-flex; align-items: center; gap: 14px;
        font-family: var(--font-display); font-size: clamp(1.4rem, 3.5vw, 2.4rem);
        letter-spacing: 0.02em; color: #fff;
        padding: 18px 32px; background: var(--accent); border-radius: 999px;
        text-transform: uppercase; transition: all 0.5s var(--ease-fluid);
        box-shadow: 0 16px 50px var(--accent-red-glow);
        margin-bottom: 40px;
      }
      .play-giant:hover { transform: translateY(-4px) scale(1.02); box-shadow: 0 24px 70px var(--accent-red-glow), 0 0 0 4px rgba(230,25,25,0.25); }
      .play-giant .arrow { width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; transition: transform 0.4s var(--ease-fluid); }
      .play-giant:hover .arrow { transform: translateX(6px); }
      .hero-stats { display: flex; gap: 48px; flex-wrap: wrap; font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
      .hero-stats .stat-val { display: block; font-family: var(--font-display); font-size: 1.6rem; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.02em; }

      /* === MARQUEE === */
      .marquee { border-top: 1px solid var(--border-hairline); border-bottom: 1px solid var(--border-hairline); background: var(--bg-panel); overflow: hidden; padding: 18px 0; position: relative; }
      .marquee-track {
        display: flex; gap: 80px; white-space: nowrap;
        animation: marquee 28s linear infinite;
        font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.2em;
        text-transform: uppercase; color: var(--text-muted);
      }
      .marquee-track span.sep { color: var(--accent); }
      @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

      /* === SECTIONS === */
      section.block { padding: 120px 0; position: relative; }
      .block-head { margin-bottom: 60px; display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
      .block-head h2 { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.4rem); text-transform: uppercase; line-height: 0.95; margin-top: 16px; }
      .block-head p { color: var(--text-secondary); max-width: 460px; font-size: 0.95rem; }

      /* === KILLER DOSSIER (interactive) === */
      .dossier { display: grid; grid-template-columns: 320px 1fr; gap: 24px; align-items: stretch; }
      @media (max-width: 960px) { .dossier { grid-template-columns: 1fr; } }

      .killer-nav { display: flex; flex-direction: column; gap: 12px; }
      .killer-tab {
        display: flex; align-items: center; gap: 14px;
        background: var(--bg-card); border: 1px solid var(--border-hairline);
        border-radius: 16px; padding: 16px 18px; text-align: left; width: 100%;
        transition: all 0.45s var(--ease-fluid); position: relative; overflow: hidden;
      }
      .killer-tab:hover { background: var(--bg-card-hover); border-color: var(--border-strong); transform: translateX(4px); }
      .killer-tab.active { border-color: var(--accent); background: rgba(230,25,25,0.08); box-shadow: 0 8px 30px rgba(230,25,25,0.14); }
      .killer-tab.active::before {
        content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--accent);
      }
      .killer-tab .glyph {
        width: 46px; height: 46px; border-radius: 12px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-family: var(--font-display); font-size: 1.2rem; color: var(--accent);
        background: rgba(230,25,25,0.1); border: 1px solid rgba(230,25,25,0.25);
      }
      .killer-tab .kt-name { font-family: var(--font-display); font-size: 1.05rem; text-transform: uppercase; color: #fff; }
      .killer-tab .kt-role { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); }

      .dossier-panel {
        background: var(--bg-card); border: 1px solid var(--border-hairline);
        border-radius: 22px; padding: 36px; position: relative; overflow: hidden; min-height: 520px;
      }
      @media (max-width: 600px) { .dossier-panel { padding: 24px 20px; } }
      .dossier-panel::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(600px 300px at 100% 0%, rgba(230,25,25,0.08), transparent 70%);
        pointer-events: none;
      }
      .dp-content { position: relative; z-index: 1; animation: dpIn 0.55s var(--ease-out-back); }
      @keyframes dpIn { from { opacity: 0; transform: translateY(18px) scale(0.985); } to { opacity: 1; transform: none; } }
      .dp-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 18px; }
      .dp-name { font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.8rem); text-transform: uppercase; line-height: 1; }
      .dp-quote { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); text-align: right; max-width: 240px; }
      .dp-lore { color: var(--text-secondary); font-size: 0.94rem; max-width: 640px; margin-bottom: 26px; }

      .dp-skill {
        background: var(--bg-deep); border: 1px solid var(--border-strong);
        border-left: 3px solid var(--accent); border-radius: 12px;
        padding: 18px 22px; margin-bottom: 26px;
      }
      .dp-skill .skill-label { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px; }
      .dp-skill .skill-name { font-family: var(--font-display); font-size: 1.2rem; text-transform: uppercase; margin-bottom: 6px; }
      .dp-skill .skill-desc { font-size: 0.86rem; color: var(--text-secondary); }

      .dp-subhead { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px; }
      .dp-perks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 26px; }
      @media (max-width: 760px) { .dp-perks { grid-template-columns: 1fr; } }
      .dp-perk {
        background: var(--bg-deep); border: 1px solid var(--border-hairline);
        border-radius: 12px; padding: 16px; transition: all 0.4s var(--ease-fluid);
      }
      .dp-perk:hover { border-color: var(--accent); transform: translateY(-3px); box-shadow: 0 10px 26px rgba(230,25,25,0.12); }
      .dp-perk .pname { font-weight: 700; font-size: 0.92rem; color: #fff; margin-bottom: 4px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
      .dp-perk .plvl { font-family: var(--font-mono); font-size: 0.58rem; color: var(--accent-amber); border: 1px solid rgba(251,191,36,0.4); padding: 2px 7px; border-radius: 4px; flex-shrink: 0; }
      .dp-perk .pdesc { font-size: 0.78rem; color: var(--text-secondary); line-height: 1.5; }

      .dp-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
      @media (max-width: 520px) { .dp-stats { grid-template-columns: 1fr; } }
      .stat-row .slabel { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px; display: flex; justify-content: space-between; }
      .stat-row .sval { color: var(--text-primary); font-family: var(--font-mono); font-size: 0.72rem; }
      .stat-bar { height: 6px; background: #232323; border-radius: 3px; overflow: hidden; }
      .stat-bar .fill { height: 100%; background: linear-gradient(90deg, var(--accent), #ff5a5a); border-radius: 3px; width: 0; transition: width 1s var(--ease-fluid); }

      /* === PERKS SHOWCASE === */
      .perks-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
      @media (max-width: 900px) { .perks-grid-3 { grid-template-columns: 1fr; } }
      .perk-show {
        background: var(--bg-card); border: 1px solid var(--border-hairline);
        border-radius: 18px; padding: 28px; position: relative; overflow: hidden;
        transition: all 0.5s var(--ease-fluid);
      }
      .perk-show::after {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(300px 160px at 50% -20%, rgba(230,25,25,0.12), transparent 70%);
        opacity: 0; transition: opacity 0.5s;
      }
      .perk-show:hover { border-color: var(--accent); transform: translateY(-6px); box-shadow: 0 20px 50px rgba(230,25,25,0.14); }
      .perk-show:hover::after { opacity: 1; }
      .perk-show .tier-badge {
        display: inline-block; font-family: var(--font-display); font-size: 0.78rem;
        letter-spacing: 0.08em; color: var(--accent); border: 1px solid var(--accent);
        border-radius: 4px; padding: 3px 10px; margin-bottom: 16px;
        background: rgba(230,25,25,0.1);
      }
      .perk-show h3 { font-family: var(--font-display); font-size: 1.3rem; text-transform: uppercase; margin-bottom: 10px; }
      .perk-show .pdesc-main { font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 14px; }
      .perk-show .levels { display: flex; gap: 6px; }
      .perk-show .lvl { flex: 1; text-align: center; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.06em; padding: 6px 4px; border-radius: 6px; border: 1px solid; }
      .lvl.l1 { color: var(--accent-amber); border-color: rgba(251,191,36,0.35); background: rgba(251,191,36,0.06); }
      .lvl.l2 { color: var(--accent-green); border-color: rgba(74,222,128,0.35); background: rgba(74,222,128,0.06); }
      .lvl.l3 { color: var(--accent); border-color: rgba(230,25,25,0.4); background: rgba(230,25,25,0.07); }
      .perk-show .flavor { margin-top: 14px; font-size: 0.78rem; color: var(--text-muted); font-style: italic; }

      /* === ROADMAP / COMING SOON === */
      .roadmap { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
      @media (max-width: 900px) { .roadmap { grid-template-columns: 1fr; } }
      .road-card {
        background: var(--bg-card); border: 1px solid var(--border-hairline);
        border-radius: 18px; padding: 28px; position: relative; overflow: hidden;
        transition: all 0.5s var(--ease-fluid);
      }
      .road-card:hover { border-color: var(--border-strong); transform: translateY(-4px); }
      .road-card .rc-icon {
        width: 44px; height: 44px; border-radius: 12px; margin-bottom: 16px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,0.04); border: 1px solid var(--border-hairline);
      }
      .road-card .rc-icon svg { width: 20px; height: 20px; fill: var(--text-muted); }
      .road-card h3 { font-family: var(--font-display); font-size: 1.15rem; text-transform: uppercase; margin-bottom: 8px; }
      .road-card p { font-size: 0.84rem; color: var(--text-secondary); margin-bottom: 16px; }
      .road-card .soon {
        display: inline-flex; align-items: center; gap: 6px;
        font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--accent-amber);
        border: 1px dashed rgba(251,191,36,0.45); padding: 4px 10px; border-radius: 4px;
      }
      .road-card .soon .blink { width: 5px; height: 5px; border-radius: 50%; background: var(--accent-amber); animation: pulse 1.6s infinite; }
      .road-card .rc-lock {
        position: absolute; top: 22px; right: 22px;
        font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.14em;
        color: var(--text-muted); border: 1px solid var(--border-hairline);
        padding: 3px 8px; border-radius: 4px;
      }

      /* === ITEMS STRIP === */
      .items-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
      @media (max-width: 900px) { .items-strip { grid-template-columns: 1fr; } }
      .item-card {
        background: var(--bg-card); border: 1px solid var(--border-hairline);
        border-radius: 16px; padding: 24px; display: flex; gap: 16px; align-items: center;
        transition: all 0.45s var(--ease-fluid);
      }
      .item-card:hover { border-color: var(--accent); background: var(--bg-card-hover); transform: translateY(-3px); }
      .item-card .item-glyph {
        width: 52px; height: 52px; border-radius: 12px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,0.03); border: 1px solid var(--border-hairline);
      }
      .item-card .item-glyph svg { width: 24px; height: 24px; fill: var(--accent); }
      .item-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 2px; }
      .item-card .item-meta { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }

      /* === QUIZ === */
      .quiz-wrap { background: var(--bg-card); border: 1px solid var(--border-hairline); border-radius: 24px; padding: 48px; max-width: 780px; margin: 0 auto; }
      @media (max-width: 600px) { .quiz-wrap { padding: 28px 20px; } }
      .quiz-q { margin-bottom: 32px; }
      .quiz-q h3 { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; }
      .quiz-q .q-text { font-size: 1.1rem; font-weight: 600; margin-bottom: 16px; color: #fff; }
      .quiz-opts { display: flex; flex-wrap: wrap; gap: 10px; }
      .quiz-opt {
        font-family: var(--font-body); font-size: 0.9rem;
        padding: 12px 22px; border-radius: 999px;
        border: 1px solid var(--border-strong); background: var(--bg-deep);
        color: var(--text-secondary); transition: all 0.35s var(--ease-fluid);
      }
      .quiz-opt:hover { border-color: var(--accent); color: #fff; background: rgba(230,25,25,0.1); }
      .quiz-opt.selected { border-color: var(--accent); background: rgba(230,25,25,0.2); color: #fff; box-shadow: 0 0 0 1px var(--accent); }
      .quiz-next {
        margin-top: 24px; font-family: var(--font-mono); font-size: 0.78rem;
        letter-spacing: 0.1em; text-transform: uppercase;
        padding: 12px 24px; border-radius: 999px; background: #fff; color: #000;
        transition: all 0.4s var(--ease-fluid);
      }
      .quiz-next:hover { transform: translateX(4px); }
      .quiz-next:disabled { opacity: 0.35; cursor: not-allowed; transform: none; }

      .quiz-result { text-align: center; display: none; }
      .quiz-result.show { display: block; animation: fadeUp 0.6s var(--ease-out-back); }
      @keyframes fadeUp { from { opacity: 0; transform: translateY(20px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
      .result-card {
        background: var(--bg-deep); border: 2px solid var(--accent); border-radius: 20px;
        padding: 36px; margin-top: 20px; animation: stampIn 0.6s var(--ease-out-back);
      }
      @keyframes stampIn { 0% { transform: scale(0.9); opacity: 0; } 60% { transform: scale(1.03); } 100% { transform: scale(1); opacity: 1; } }
      .result-card .result-name { font-family: var(--font-display); font-size: 2rem; text-transform: uppercase; color: #fff; margin-bottom: 8px; }
      .result-card .result-tag { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 16px; }
      .result-card p { color: var(--text-secondary); font-size: 0.92rem; max-width: 480px; margin: 0 auto 24px; }
      .result-card .result-link { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); }
      .result-card .result-link svg { width: 14px; height: 14px; fill: currentColor; transition: transform 0.3s; }
      .result-card .result-link:hover svg { transform: translateX(4px); }

      /* === MYTHS === */
      .myths-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
      @media (max-width: 760px) { .myths-grid { grid-template-columns: 1fr; } }
      .myth-card {
        background: var(--bg-card); border: 1px solid var(--border-hairline);
        border-radius: 18px; padding: 28px; position: relative; overflow: hidden;
        transition: all 0.45s var(--ease-fluid); cursor: pointer;
      }
      .myth-card:hover { border-color: var(--border-strong); transform: translateY(-3px); }
      .myth-q { font-size: 1.05rem; font-weight: 600; color: #fff; margin-bottom: 14px; padding-right: 60px; }
      .myth-a { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55; }
      .myth-stamp {
        position: absolute; top: 20px; right: 20px;
        font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.06em;
        color: var(--accent); border: 2px solid var(--accent);
        padding: 6px 12px; border-radius: 4px; transform: rotate(-8deg);
        text-transform: uppercase; opacity: 0;
        transition: all 0.4s var(--ease-out-back);
        background: rgba(230,25,25,0.12); box-shadow: 0 0 12px var(--accent-red-glow);
      }
      .myth-card:hover .myth-stamp { opacity: 1; transform: rotate(-6deg) scale(1.05); }
      .myth-card .confirmed {
        position: absolute; top: 20px; right: 20px;
        font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em;
        text-transform: uppercase; color: var(--accent-green);
        border: 1px solid rgba(74,222,128,0.5); padding: 4px 10px; border-radius: 4px; opacity: 0.7;
      }

      /* === FOOTER === */
      footer { background: var(--bg-panel); border-top: 1px solid var(--border-hairline); padding: 80px 0 40px; position: relative; }
      .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; margin-bottom: 60px; }
      @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr; } }
      .footer-brand { display: flex; align-items: center; gap: 12px; font-family: var(--font-display); font-size: 1.4rem; margin-bottom: 16px; }
      .footer-brand img { width: 36px; height: 36px; border-radius: 8px; }
      .footer-brand .vd-dot { color: var(--accent); }
      .footer-desc { color: var(--text-secondary); font-size: 0.88rem; max-width: 340px; }
      .footer-col h4 { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 16px; }
      .footer-col ul { list-style: none; }
      .footer-col li { margin-bottom: 10px; }
      .footer-col a { font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-secondary); transition: color 0.3s; display: inline-flex; align-items: center; gap: 8px; }
      .footer-col a:hover { color: var(--accent); }
      .footer-bottom {
        border-top: 1px solid var(--border-hairline); padding-top: 24px;
        display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;
        font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted);
        text-transform: uppercase; letter-spacing: 0.1em;
      }
      .credit-terminal {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 6px 12px; border-radius: 6px;
        background: rgba(230, 25, 25, 0.06); border: 1px solid var(--border-hairline);
      }

      /* === TOAST === */
      .toast {
        position: fixed; bottom: 32px; left: 50%;
        transform: translateX(-50%) translateY(120%);
        background: var(--bg-panel); border: 1px solid var(--accent-green); color: var(--accent-green);
        padding: 12px 24px; border-radius: 999px;
        font-family: var(--font-mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em;
        z-index: 3000; transition: transform 0.5s var(--ease-out-back);
        box-shadow: 0 8px 24px rgba(74,222,128,0.15);
      }
      .toast.show { transform: translateX(-50%) translateY(0); }

      /* === FOG CANVAS (hero) === */
      .fog-canvas { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; pointer-events: none; }
      .fog-hint {
        position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%);
        z-index: 3; pointer-events: none;
        font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.2em;
        text-transform: uppercase; color: var(--text-muted);
        border: 1px solid var(--border-hairline); padding: 7px 16px; border-radius: 999px;
        background: rgba(10,10,10,0.6); backdrop-filter: blur(6px);
        transition: opacity 1.4s ease;
      }
      .fog-hint.gone { opacity: 0; }

      /* === THREAT FIELD (killer dossier) === */
      .dossier { position: relative; }
      .threat-field { position: absolute; inset: -40px; z-index: 0; pointer-events: none; }
      .threat-field::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(240px circle at var(--tx, 50%) var(--ty, 50%),
          rgba(230, 25, 25, calc(0.42 * var(--threat, 0))) 0%,
          rgba(230, 25, 25, calc(0.12 * var(--threat, 0))) 45%,
          transparent 75%);
      }
      .threat-field .heartbeat {
        position: absolute; left: var(--tx, 50%); top: var(--ty, 50%);
        width: 130px; height: 130px; margin: -65px 0 0 -65px;
        border-radius: 50%; border: 2px solid rgba(230,25,25,0.75);
        opacity: calc(0.85 * var(--threat, 0));
        animation: heartbeat 1.6s ease-in-out infinite;
      }
      @keyframes heartbeat { 0%, 100% { transform: scale(0.7); } 50% { transform: scale(1.15); } }
      .threat-label {
        position: absolute; top: 6px; right: 10px;
        font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.16em;
        text-transform: uppercase; color: var(--accent);
        opacity: calc(0.2 + 0.8 * var(--threat, 0));
      }
      .dossier > *:not(.threat-field) { position: relative; z-index: 1; }

      /* === SKILL CHECK TRAINER === */
      .sc-wrap {
        display: grid; grid-template-columns: minmax(0, 460px) 1fr; gap: 44px; align-items: center;
        background: var(--bg-card); border: 1px solid var(--border-hairline);
        border-radius: 24px; padding: 44px;
      }
      @media (max-width: 820px) { .sc-wrap { grid-template-columns: 1fr; padding: 28px 20px; gap: 28px; } }
      /* === SKILL CHECK — 1:1 after the in-game repair UI ===
         Monochrome: thin white ring on dark glass, white success arc,
         amber Great mark, thin red needle from centre, white [SPACE] plate. */
      #skillcheck {
        position: relative;
        background:
          radial-gradient(900px 520px at 50% 0%, rgba(40,24,12,0.55), transparent 65%),
          linear-gradient(180deg, #0d0907 0%, #0a0705 60%, #070504 100%);
      }
      #skillcheck::before {
        content: ''; position: absolute; inset: 0; pointer-events: none;
        background: repeating-linear-gradient(0deg, rgba(0,0,0,0.24) 0 2px, transparent 2px 4px);
        opacity: 0.3; mix-blend-mode: multiply;
      }
      #skillcheck .container { position: relative; }

      /* Arena: the game container. Taller than wide so the centred dial has
         clear space above the corner-pinned REPAIR block. */
      .sc-arena { position: relative; width: 100%; max-width: 420px; aspect-ratio: 1 / 1.25; margin: 0 auto;
        --dial: min(70%, 300px); }

      .sc-dial { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
        width: var(--dial); aspect-ratio: 1; border-radius: 50%;
        background: rgba(12,10,9,0.78); backdrop-filter: blur(4px); }
      .sc-dial::after { /* faint inner vignette */
        content: ''; position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
        background: radial-gradient(circle, transparent 55%, rgba(0,0,0,0.45) 100%);
      }
      .sc-svg { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
        width: var(--dial); height: auto; overflow: visible; cursor: pointer; z-index: 1; }
      .sc-svg:focus { outline: none; }
      .sc-svg:focus-visible { filter: drop-shadow(0 0 10px rgba(255,42,42,0.8)); }

      .sc-ring { fill: none; stroke: #ffffff; stroke-width: 1.5; opacity: 0.9; }

      .sc-zone { fill: none; stroke: #ffffff; stroke-width: 9; stroke-linecap: butt;
        filter: drop-shadow(0 0 4px rgba(255,255,255,0.55)); }
      .sc-zone-outline { fill: none; stroke: rgba(255,255,255,0.28); stroke-width: 12; stroke-linecap: butt; }
      .sc-great { fill: none; stroke: #ffb84d; stroke-width: 9; stroke-linecap: butt;
        filter: drop-shadow(0 0 6px rgba(255,184,77,0.95)); }
      /* One clean thin red line — no glow, no double edge. */
      .sc-needle { stroke: #ff0000; stroke-width: 2; stroke-linecap: butt; }

      /* Centre key plate */
      .sc-key { position: absolute; z-index: 2; left: 50%; top: 50%; transform: translate(-50%, -50%);
        display: flex; align-items: center; gap: 6px;
        border: 1.5px solid #ffffff; border-radius: 6px; padding: 9px 16px;
        background: rgba(0,0,0,0.5); user-select: none; pointer-events: none; }
      .sc-key span { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.16em; color: #ffffff; }

      .sc-flash { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
        width: var(--dial); aspect-ratio: 1; border-radius: 50%; pointer-events: none; opacity: 0; z-index: 3; }
      .sc-flash.miss { background: radial-gradient(circle, rgba(255,42,42,0.5), transparent 70%); animation: scFlash 0.45s ease-out; }
      .sc-flash.great { background: radial-gradient(circle, rgba(255,214,140,0.55), transparent 70%); animation: scFlash 0.45s ease-out; }
      .sc-flash.good { background: radial-gradient(circle, rgba(255,255,255,0.35), transparent 70%); animation: scFlash 0.3s ease-out; }
      @keyframes scFlash { from { opacity: 1; } to { opacity: 0; } }

      /* REPAIR block — own HTML block, corner of the container, clear of the dial */
      .sc-repair { position: absolute; left: 20px; bottom: 20px; z-index: 2;
        display: flex; align-items: center; gap: 12px; }
      .sc-hand { width: 30px; height: 30px; fill: #ffffff; flex: none; }
      .sc-repair-col { display: flex; flex-direction: column; gap: 6px; }
      .sc-repair-label { font-family: var(--font-body); font-weight: 700; font-size: 0.82rem;
        letter-spacing: 0.1em; color: #ffffff; text-transform: uppercase; }
      .sc-repair-track { width: clamp(120px, 26vw, 240px); height: 9px;
        background: #1a1a1a; border: 1px solid rgba(255,255,255,0.35); }
      .sc-repair-fill { height: 100%; width: 0%; background: #ffffff;
        transition: width 0.25s var(--ease-fluid); }
      .sc-wrap.shake { animation: scShake 0.4s; }
      @keyframes scShake { 0%,100% { transform: translateX(0); } 20% { transform: translateX(-7px); } 40% { transform: translateX(6px); } 60% { transform: translateX(-4px); } 80% { transform: translateX(3px); } }
      /* During a repair only the dial + REPAIR bar may be seen; the side panel
         (buttons, stats) fades out and stops taking clicks until the run ends. */
      .sc-side { display: flex; flex-direction: column; gap: 20px;
        transition: opacity 0.3s var(--ease-fluid); }
      .sc-wrap.playing .sc-side { opacity: 0; pointer-events: none; }

      /* Focus mode: on Start Repair the whole page dims, the dial glides up
         and grows slightly into the middle of the viewport; on a win or reset
         it glides back to its seat. */
      .sc-backdrop { position: fixed; inset: 0; z-index: 2000; pointer-events: none;
        background: rgba(6,4,3,0.96);
        opacity: 0; transition: opacity 0.5s var(--ease-fluid); }
      #skillcheck.playing .sc-backdrop { opacity: 1; }
      .sc-wrap.playing { position: relative; z-index: 2100; }
      .sc-arena { transition: transform 0.65s var(--ease-fluid); }
      .sc-cta { display: flex; gap: 12px; flex-wrap: wrap; }
      .sc-start {
        font-family: var(--font-display); font-size: 0.95rem; letter-spacing: 0.08em;
        text-transform: uppercase; padding: 12px 26px; border-radius: 999px;
        background: #ffffff; color: #0b0b0b;
        transition: all 0.3s var(--ease-fluid); box-shadow: 0 8px 26px rgba(255,255,255,0.18);
      }
      .sc-start:hover { transform: translateY(-2px); box-shadow: 0 14px 34px rgba(255,255,255,0.3); }
      .sc-reset {
        font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em;
        text-transform: uppercase; padding: 12px 20px; border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.4); color: rgba(255,255,255,0.7);
        transition: all 0.3s; background: rgba(255,255,255,0.05);
      }
      .sc-reset:hover { border-color: #ff2a2a; color: #ffffff; }
      .sc-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
      @media (max-width: 520px) { .sc-stats { grid-template-columns: repeat(2, 1fr); } }
      .sc-stat { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.14);
        border-radius: 8px; padding: 10px 8px; text-align: center; }
      .sc-stat .ss-val { display: block; font-family: var(--font-display); font-size: 1.15rem; color: #ffffff; }
      .sc-stat .ss-lab { font-family: var(--font-mono); font-size: 0.52rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
      .sc-status { font-family: var(--font-mono); font-size: 0.72rem; color: rgba(255,255,255,0.65); letter-spacing: 0.04em; min-height: 1.4em; }
      .sc-status.win { color: #ffd28c; text-shadow: 0 0 12px rgba(255,184,77,0.6); }
      .sc-status.miss { color: #ff4a3a; text-shadow: 0 0 12px rgba(255,42,42,0.55); }

      /* === SCROLL REVEAL === */
      .reveal { opacity: 1; transform: none; transition: opacity 0.8s var(--ease-fluid), transform 0.8s var(--ease-fluid); }
      .reveal.reveal-hidden { opacity: 0; transform: translateY(40px); }
      .reveal.visible { opacity: 1; transform: translateY(0); }
    </style>
  </head>
  <body>
    <!-- NAV -->
    <nav>
      <a href="#" class="nav-logo">
