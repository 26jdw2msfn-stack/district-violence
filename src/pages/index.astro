    <script is:inline>
      // === KILLER DOSSIER DATA (from the official wiki) ===
      const KILLERS = {
        veil: {
          name: 'The Veil',
          quote: '"Your strikes distort time."',
          lore: 'She ran from her own wedding after the worst news of her life — and an accident claimed her on the cold iron below. Her spirit lingers now, pierced by the spears that ended her, promising others the same fate.',
          skill: 'Pierced Vow',
          skillDesc: 'Switch from dagger to the spears lodged in her body. Charge and throw to slow survivors on headshots by 30%. Holds 2 spears, recharging every 15 seconds. Charge longer and the spear crosses into the other world — passing clean through walls.',
          perks: [
            { name: 'Piercing Reverie', lvl: 'LVL 15', desc: 'First hook blocks the top generator for 18s and boosts regression speed.' },
            { name: 'Blood Between Worlds', lvl: 'LVL 30', desc: 'When a survivor loses a health state, the 2 best generators regress at up to 175% speed.' },
            { name: 'Echo Of The Void', lvl: 'LVL 45', desc: 'A survivor staring at you gets their aura revealed — and their view turns monochrome.' },
          ],
          stats: [
            { label: 'Movement Speed', val: '110%', pct: 55 },
            { label: 'Intent Radius', val: '90 studs', pct: 60 },
          ],
        },
        killer: {
          name: 'The Killer',
          quote: '"I spoke to the devil in Miami."',
          lore: 'An amateur inspired by the urban legend. His clumsiness and sloppy methods betray his inexperience — but pair that with raw agility and erratic behavior and he becomes a real threat to groups.',
          skill: 'Frenzy',
          skillDesc: 'For 13 seconds: vault pallets instantly, move at 150% speed, and track every survivor in an enlarged terror radius with Killer Instinct. Every chained hit refills the gauge and makes him faster. The fourth hit downs outright — miss or get stunned, and fatigue stops him cold.',
          perks: [
            { name: 'Terror Spread', lvl: 'LVL 15', desc: 'Survivors finish a generator and suffer the Winded status for up to 40 seconds.' },
            { name: 'Sloppy Mess', lvl: 'LVL 30', desc: 'Basic hits make survivors bleed more and slow their healing by up to 35%.' },
            { name: 'Resentment Clinger', lvl: 'LVL 45', desc: 'Stuns and spikes grant tokens — each one extends lunge range by up to 50%.' },
          ],
          stats: [
            { label: 'Movement Speed', val: '115%', pct: 62 },
            { label: 'Intent Radius', val: '90 studs', pct: 60 },
          ],
        },
        masked: {
          name: 'The Masked',
          quote: '"Do you like hurting other people?"',
          lore: 'After cryptic messages left on his answering machine, he set out to recreate the slaughters that tore through Miami from 1989 to 1991 — all to catch the attention of 50 Blessings.',
          skill: 'Mask Up',
          skillDesc: 'Swap to a random mask every 30 seconds for a full minute, each one changing the game: the Tiger mask turns fists into instant downs, the Rat mask kills his terror radius entirely, and the Swan mask brings out a chainsaw.',
          perks: [
            { name: 'Hard Swing', lvl: 'LVL 15', desc: 'Basic hits apply the Winded status, shutting down survivor speed perks.' },
            { name: 'Combo Streak', lvl: 'LVL 30', desc: 'Every basic hit grants a 5% speed boost for up to 13 seconds.' },
            { name: 'Crackdown', lvl: 'LVL 45', desc: 'Generator kicks drain up to 9 extra charges.' },
          ],
          stats: [
            { label: 'Movement Speed', val: '115%', pct: 62 },
            { label: 'Intent Radius', val: '90 studs', pct: 60 },
          ],
        },
      };

      const dpContent = document.getElementById('dpContent');
      const killerNav = document.getElementById('killerNav');

      function renderKiller(key) {
        const k = KILLERS[key];
        if (!k) return;
        dpContent.innerHTML = `
          <div class="dp-top">
            <div class="dp-name display">${k.name}</div>
            <div class="dp-quote">${k.quote}</div>
          </div>
          <p class="dp-lore">${k.lore}</p>
          <div class="dp-skill">
            <div class="skill-label">Signature Skill</div>
            <div class="skill-name">${k.skill}</div>
            <div class="skill-desc">${k.skillDesc}</div>
          </div>
          <div class="dp-subhead">Personal Perks</div>
          <div class="dp-perks">
            ${k.perks.map(p => `
              <div class="dp-perk">
                <div class="pname"><span>${p.name}</span><span class="plvl">${p.lvl}</span></div>
                <div class="pdesc">${p.desc}</div>
              </div>`).join('')}
          </div>
          <div class="dp-subhead">Base Stats</div>
          <div class="dp-stats">
            ${k.stats.map(s => `
              <div class="stat-row">
                <div class="slabel"><span>${s.label}</span><span class="sval">${s.val}</span></div>
                <div class="stat-bar"><div class="fill" data-pct="${s.pct}"></div></div>
              </div>`).join('')}
          </div>
        `;
        // restart entrance animation
        dpContent.style.animation = 'none';
        void dpContent.offsetHeight;
        dpContent.style.animation = '';
        // animate stat bars
        requestAnimationFrame(() => {
          dpContent.querySelectorAll('.fill').forEach(f => { f.style.width = f.dataset.pct + '%'; });
        });
        // sync the terror-radius readout with this killer
        const tl = document.getElementById('threatLabel');
        if (tl && k.stats[1]) tl.textContent = 'Terror Radius · ' + k.stats[1].val;
      }

      killerNav.addEventListener('click', (e) => {
        const tab = e.target.closest('.killer-tab');
        if (!tab) return;
        killerNav.querySelectorAll('.killer-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        renderKiller(tab.dataset.killer);
      });
      renderKiller('veil');

      // === QUIZ ===
      const opts = document.querySelectorAll('.quiz-opt');
      const nextBtn = document.getElementById('quizNext');
      const quizFlow = document.getElementById('quizFlow');
      const quizResult = document.getElementById('quizResult');
      let currentQ = 1;
      const answers = [];

      const RESULTS = {
        chase: { name: 'The Loopers', desc: 'You want the killer looking at you and nobody else. Start with vault and stun perks — Flowstate, Great Collapse — and learn every pallet on the map.' },
        gen: { name: 'The Engineer', desc: 'You win matches by making generators disappear. Group Project and Flawless Execution were built for you — stack repair speed and hit your skill checks.' },
        team: { name: 'The Medic', desc: 'Nobody gets left behind on your watch. Grab My Hand, Nobody Left Behind and Enhanced Touch — keep the squad alive and the escapes rolling.' },
      };

      function updateQuiz() {
        document.querySelectorAll('.quiz-q').forEach(q => {
          const n = parseInt(q.dataset.q, 10);
          q.style.display = n === currentQ ? 'block' : 'none';
        });
        nextBtn.textContent = currentQ === 3 ? 'See Result →' : 'Next →';
      }

      opts.forEach(opt => {
        opt.addEventListener('click', () => {
          opt.parentElement.querySelectorAll('.quiz-opt').forEach(o => o.classList.remove('selected'));
          opt.classList.add('selected');
          answers[parseInt(opt.parentElement.dataset.q, 10) - 1] = opt.dataset.val;
          nextBtn.disabled = false;
        });
      });

      nextBtn.addEventListener('click', () => {
        if (nextBtn.disabled) return;
        if (currentQ < 3) {
          currentQ++;
          updateQuiz();
          nextBtn.disabled = true;
        } else {
          // most common answer wins
          const counts = {};
          answers.forEach(a => counts[a] = (counts[a] || 0) + 1);
          const top = Object.keys(counts).sort((a, b) => counts[b] - counts[a])[0];
          const r = RESULTS[top] || RESULTS.chase;
          document.getElementById('resultName').textContent = r.name;
          document.getElementById('resultDesc').textContent = r.desc;
          quizFlow.style.display = 'none';
          quizResult.classList.add('show');
        }
      });

      // === MYTH STAMP TOGGLE (touch devices) ===
      document.querySelectorAll('.myth-card').forEach(card => {
        card.addEventListener('click', () => {
          const stamp = card.querySelector('.myth-stamp');
          if (stamp) stamp.style.opacity = stamp.style.opacity === '1' ? '0' : '1';
        });
      });

      // === TOAST ===
      function showToast(msg) {
        const toast = document.getElementById('toast');
        toast.textContent = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2400);
      }

      // === MARQUEE WIDTH ===
      const marquee = document.getElementById('marquee');
      if (marquee) marquee.style.width = 'max-content';

      // === SCROLL REVEAL ===
      const isScreenshot = new URLSearchParams(window.location.search).has('screenshot');
      const fold = window.innerHeight;
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach(el => {
        if (isScreenshot) { el.classList.add('visible'); return; }
        const rect = el.getBoundingClientRect();
        if (rect.top > fold + 200) el.classList.add('reveal-hidden');
        revealObserver.observe(el);
      });

      // === SMOOTH SCROLL WITH NAV OFFSET ===
      document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', (e) => {
          const id = a.getAttribute('href');
          if (id.length > 1) {
            const target = document.querySelector(id);
            if (target) {
              e.preventDefault();
              const y = target.getBoundingClientRect().top + window.scrollY - 90;
              window.scrollTo({ top: y, behavior: 'smooth' });
            }
          }
        });
      });

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // === FOG CANVAS — cursor wipes the mist off the hero ===
      (function fog() {
        const canvas = document.getElementById('fogCanvas');
        const hint = document.getElementById('fogHint');
        if (!canvas) return;
        const hero = document.querySelector('.hero');
        const ctx = canvas.getContext('2d');
        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        // Pre-render a soft noise tile once — the live loop only blits it.
        const tile = document.createElement('canvas');
        tile.width = tile.height = 220;
        const tctx = tile.getContext('2d');
        const img = tctx.createImageData(220, 220);
        for (let i = 0; i < img.data.length; i += 4) {
          const n = Math.random();
          const v = 13 + n * 11;
          img.data[i] = v; img.data[i + 1] = v; img.data[i + 2] = v + 3;
          img.data[i + 3] = Math.round(55 + n * 155);
        }
        tctx.putImageData(img, 0, 0);

        let W = 0, H = 0;
        function resize() {
          W = hero.clientWidth; H = hero.clientHeight;
          canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
          canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        resize();
        window.addEventListener('resize', resize);

        // Vertical parting beam: follows the cursor's X across the full hero
        // height, with soft gradient edges on both sides. Fades in on move,
        // out when the pointer leaves, so the photo only ever shows inside
        // the beam — the rest stays buried in fog.
        let targetX = 0, beamX = 0, targetA = 0, beamA = 0, beamInit = false;
        let t = 0, visible = true;
        // Touch devices have no hover: the beam needs other ways to move.
        const coarse = window.matchMedia('(pointer: coarse)').matches;
        let lastPointerAt = 0, tiltX = null;
        const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.05 });
        io.observe(hero);

        // A touch has no hover: track the down position so a tap (down+up with
        // no real movement) can be told apart from a drag.
        let downX = null, dragged = false;
        function aimAt(e) {
          const r = canvas.getBoundingClientRect();
          targetX = e.clientX - r.left;
          if (!beamInit) { beamX = targetX; beamInit = true; }
          targetA = 1;
          lastPointerAt = performance.now();
          if (hint) hint.classList.add('gone');
        }
        hero.addEventListener('pointermove', (e) => {
          if (downX !== null && Math.abs(e.clientX - downX) > 10) dragged = true;
          aimAt(e);
        });
        // A tap is a down+up with no move — part the fog at the touch point
        // anyway, so a single touch works, not only a drag.
        hero.addEventListener('pointerdown', (e) => { downX = e.clientX; dragged = false; aimAt(e); });
        // A mouse keeps hovering after a click; a finger lifts. Only a real
        // drag closes the beam — a tap leaves the part open until the idle
        // sweep reclaims it, so a single touch is not a dead touch.
        hero.addEventListener('pointerup', (e) => {
          if (e.pointerType !== 'mouse' && dragged) targetA = 0;
          downX = null; dragged = false;
        });
        hero.addEventListener('pointercancel', () => { downX = null; dragged = false; });
        // A real mouse leaving the hero should close the beam; on touch,
        // pointerleave also fires right after lift, and pointerup has already
        // decided — closing here too would snuff a tap the instant it lands.
        hero.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') targetA = 0; });

        // Phone tilt: gamma is left/right rotation, mapped onto the hero.
        try {
          window.addEventListener('deviceorientation', (e) => {
            if (e.gamma == null) return;
            const g = Math.max(-40, Math.min(40, e.gamma));
            tiltX = W * (0.5 + (g / 40) * 0.45);
          });
        } catch (_) {}
        // iOS 13+ gates the gyroscope behind a permission prompt — ask once,
        // on the first touch, so it never blocks the page.
        try {
          if (typeof DeviceOrientationEvent !== 'undefined' &&
              typeof DeviceOrientationEvent.requestPermission === 'function') {
            hero.addEventListener('touchstart', () => {
              DeviceOrientationEvent.requestPermission().catch(() => {});
            }, { once: true });
          }
        } catch (_) {}
        if (coarse && hint) hint.textContent = 'Drag or tilt to part the fog';

        if (reducedMotion) { canvas.style.display = 'none'; return; }

        function frame() {
          if (visible) {
            t += 0.004;
            // Clear first: the tiles are stamped every frame with source-over,
            // so without this the fog compounds to a fully opaque wall within
            // a second and buries even the beam.
            ctx.clearRect(0, 0, W, H);
            const offX = Math.sin(t) * 30, offY = Math.cos(t * 0.8) * 20;
            ctx.globalCompositeOperation = 'source-over';
            for (let x = -110; x < W + 110; x += 220) {
              for (let y = -110; y < H + 110; y += 220) {
                ctx.drawImage(tile, x + offX, y + offY);
              }
            }
            // On a touch device with no recent input, the beam is steered by
            // the gyroscope, or drifts on its own so the effect is visible
            // before the player has touched anything.
            if (coarse && performance.now() - lastPointerAt > 2500) {
              if (tiltX !== null) { targetX = tiltX; targetA = 1; }
              else { targetX = W / 2 + Math.sin(t * 0.7) * W * 0.3; targetA = 0.8; }
              if (!beamInit) { beamX = targetX; beamInit = true; }
            }
            beamX += (targetX - beamX) * 0.14;
            beamA += (targetA - beamA) * 0.06;
            if (beamA > 0.005) {
              const bw = Math.min(520, W * 0.42);
              const a = beamA.toFixed(3);
              // Soft-edged band: transparent at both rims, strongest on the
              // axis — that's the left/right gradient the beam fades through.
              const g = ctx.createLinearGradient(beamX - bw / 2, 0, beamX + bw / 2, 0);
              g.addColorStop(0, 'rgba(0,0,0,0)');
              g.addColorStop(0.5, `rgba(0,0,0,${(0.82 * a).toFixed(3)})`);
              g.addColorStop(1, 'rgba(0,0,0,0)');
              ctx.globalCompositeOperation = 'destination-out';
              ctx.fillStyle = g;
              ctx.fillRect(beamX - bw / 2, 0, bw, H);
              // A faint cool light along the part, so the beam reads as light
              // rather than a hole — keeps the photo "in fog", not naked.
              const lg = ctx.createLinearGradient(beamX - bw / 2, 0, beamX + bw / 2, 0);
              lg.addColorStop(0, 'rgba(190,210,255,0)');
              lg.addColorStop(0.5, `rgba(190,210,255,${(0.05 * a).toFixed(3)})`);
              lg.addColorStop(1, 'rgba(190,210,255,0)');
              ctx.globalCompositeOperation = 'source-over';
              ctx.fillStyle = lg;
              ctx.fillRect(beamX - bw / 2, 0, bw, H);
            }
          }
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();

      // === THREAT FIELD — cursor proximity drives the terror radius ===
      (function threat() {
        const wrap = document.getElementById('dossierWrap');
        if (!wrap || reducedMotion) return;
        function onMove(e) {
          const r = wrap.getBoundingClientRect();
          const x = e.clientX - r.left, y = e.clientY - r.top;
          const active = wrap.querySelector('.killer-tab.active');
          let tx = r.width / 2, ty = r.height / 2;
          if (active) {
            const a = active.getBoundingClientRect();
            tx = a.left + a.width / 2 - r.left;
            ty = a.top + a.height / 2 - r.top;
          }
          const dist = Math.hypot(x - tx, y - ty);
          const threat = Math.max(0, 1 - dist / 420);
          wrap.style.setProperty('--threat', threat.toFixed(2));
          wrap.style.setProperty('--tx', x + 'px');
          wrap.style.setProperty('--ty', y + 'px');
        }
        wrap.addEventListener('mousemove', onMove);
        wrap.addEventListener('mouseleave', () => wrap.style.setProperty('--threat', '0'));
      })();

      // === SKILL CHECK TRAINER ===
      (function skillCheck() {
        const svg = document.getElementById('scSvg');
        const wrap = document.getElementById('scWrap');
        if (!svg) return;
        const elZone = document.getElementById('scZone');
        const elZoneOutline = document.getElementById('scZoneOutline');
        const elGreatZone = document.getElementById('scGreatZone');
        const elNeedle = document.getElementById('scNeedle');
        const elCharge = document.getElementById('scChargeFill');
        const elFlash = document.getElementById('scFlash');
        const elStatus = document.getElementById('scStatus');
        const elStart = document.getElementById('scStart');
        const elReset = document.getElementById('scReset');
        const elStreak = document.getElementById('scStreak');
        const elGreat = document.getElementById('scGreat');
        const elMiss = document.getElementById('scMiss');
        const elBest = document.getElementById('scBest');
        const elArena = document.querySelector('.sc-arena');
        const section = document.getElementById('skillcheck');

        const KEY = 'vd_skillcheck_best';
        // Ring radius in viewBox units; the glass disc is 94% of the arena so
        // the success zone rides exactly on its edge.
        const RING_R = 94;
        // Bright Great sector rides the leading edge of the success zone — the
        // first degrees the needle sweeps into. Success zone itself is 20-30°.
        const GREAT_DEG = 4;

        const S = {
          playing: false, progress: 0, angle: 180, speed: 1.8,
          zoneStart: 0, zoneSize: 30,
          streak: 0, greats: 0, misses: 0, startMs: 0, raf: 0,
        };

        let bestMs = parseInt(localStorage.getItem(KEY) || '0', 10) || 0;
        if (bestMs) elBest.textContent = (bestMs / 1000).toFixed(1) + 's';

        function arcPath(a0, a1) {
          const r = RING_R;
          const p = (a) => [100 + r * Math.cos(a), 100 + r * Math.sin(a)];
          const [x0, y0] = p(a0), [x1, y1] = p(a1);
          const large = (a1 - a0) > Math.PI ? 1 : 0;
          return `M ${x0.toFixed(2)} ${y0.toFixed(2)} A ${r} ${r} 0 ${large} 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`;
        }
        const toRad = (deg) => (deg - 90) * Math.PI / 180;

        function drawZone() {
          const a0 = toRad(S.zoneStart);
          const a1 = toRad(S.zoneStart + S.zoneSize);
          elZoneOutline.setAttribute('d', arcPath(a0, a1));
          elZone.setAttribute('d', arcPath(a0, a1));
          elGreatZone.setAttribute('d', arcPath(a0, toRad(S.zoneStart + GREAT_DEG)));
        }
        function drawProgress() {
          elCharge.style.width = S.progress.toFixed(1) + '%';
        }
        function drawNeedle() {
          elNeedle.setAttribute('transform', `rotate(${S.angle.toFixed(1)} 100 100)`);
        }

        function newZone() {
          // Spawn the next zone ahead of the needle, within 40-160 degrees of
          // travel, so a ready player gets a hit window every half-second or so
          // instead of waiting on a full slow sweep.
          S.zoneStart = (S.angle + 40 + Math.random() * 120) % 360;
          S.zoneSize = Math.max(20, 30 - S.progress * 0.08);
          drawZone();
        }

        function setStatus(msg, cls) {
          elStatus.textContent = msg;
          elStatus.className = 'sc-status' + (cls ? ' ' + cls : '');
        }

        function flash(cls) {
          elFlash.classList.remove('miss', 'great');
          void elFlash.offsetWidth;
          elFlash.classList.add(cls);
        }

        // Focus mode: lift the arena into the middle of the viewport and scale
        // it up a touch.
        function centerDial() {
          if (!elArena) return;
          // Two things must be neutralised before measuring, or the dial
          // lands off-centre: the reveal animation (it drives the wrap's
          // transform) and any smooth scroll still in flight (it shifts the
          // page after we let go of the measurement).
          wrap.classList.remove('reveal-hidden');
          wrap.classList.add('visible');
          const hadWrapT = wrap.style.transition;
          const hadArenaT = elArena.style.transition;
          wrap.style.transition = 'none';
          elArena.style.transition = 'none';
          elArena.style.transform = '';      // measure from the seated position
          void elArena.offsetWidth;
          const r = elArena.getBoundingClientRect();
          wrap.style.transition = hadWrapT;
          elArena.style.transition = hadArenaT;
          const vw = window.innerWidth, vh = window.innerHeight;
          const kFit = Math.min((vw * 0.94) / r.width, (vh * 0.86) / r.height);
          const k = Math.min(1.5, Math.max(1.08, kFit));
          // transform-origin is the arena's own centre, so the scale keeps the
          // centre fixed and the translate carries it to the middle of the
          // viewport.
          const dx = vw / 2 - (r.left + r.width / 2);
          const dy = vh / 2 - (r.top + r.height / 2);
          elArena.style.transform =
            `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px) scale(${k.toFixed(3)})`;
        }
        function setFocus(on) {
          const root = document.documentElement;
          if (on) {
            // An in-flight smooth scroll (nav anchor click, scrollIntoView)
            // would drag the dial off-centre after we position it — cancel it.
            root.style.scrollBehavior = 'auto';
            window.scrollTo({ top: window.scrollY, behavior: 'instant' });
            root.style.overflow = 'hidden';
            section.classList.add('playing');
            centerDial();
            // Re-verify one frame later in case anything still shifted.
            requestAnimationFrame(() => { if (S.playing) centerDial(); });
          } else {
            section.classList.remove('playing');
            root.style.overflow = '';
            root.style.scrollBehavior = '';
            elArena.style.transform = '';
          }
        }
        window.addEventListener('resize', () => { if (S.playing) centerDial(); });

        function start() {
          if (S.playing) return;
          S.playing = true;
          S.progress = 0; S.angle = 180; S.speed = 1.8;
          S.streak = 0; S.greats = 0; S.misses = 0;
          S.startMs = performance.now();
          elStreak.textContent = '0'; elGreat.textContent = '0'; elMiss.textContent = '0';
          elStart.textContent = 'Repairing…';
          wrap.classList.add('playing');
          setFocus(true);
          newZone(); drawProgress(); drawNeedle();
          setStatus('Catch the white zone. Amber edge = Great.');
          loop();
        }

        function reset() {
          cancelAnimationFrame(S.raf);
          S.playing = false;
          S.progress = 0; S.angle = 180; S.speed = 1.8;
          elStreak.textContent = '0'; elGreat.textContent = '0'; elMiss.textContent = '0';
          elStart.textContent = 'Start Repair';
          wrap.classList.remove('playing');
          setFocus(false);
          elZoneOutline.setAttribute('d', '');
          elZone.setAttribute('d', ''); elGreatZone.setAttribute('d', '');
          elCharge.style.width = '0%';
          drawProgress(); drawNeedle();
          setStatus('Press Start Repair — or tap the dial.');
        }

        function loop() {
          S.angle += S.speed;
          if (S.angle >= 360) {
            // full sweep with no input = missed timing
            S.angle -= 360;
            registerMiss(true);
          }
          drawNeedle();
          if (S.playing) S.raf = requestAnimationFrame(loop);
        }

        function registerMiss(silent) {
          // A full sweep you let pass costs less than a wild tap — punishment
          // scales with recklessness, so careful play always climbs.
          S.progress = Math.max(0, S.progress - (silent ? 4 : 6));
          S.misses++; S.streak = 0;
          elMiss.textContent = S.misses;
          elStreak.textContent = '0';
          drawProgress();
          if (silent) {
            setStatus('The needle slipped past the zone…', 'miss');
          } else {
            flash('miss');
            wrap.classList.remove('shake');
            void wrap.offsetWidth;
            wrap.classList.add('shake');
            setStatus('MISSED — the generator regresses.', 'miss');
          }
        }

        function attemptHit() {
          if (!S.playing) { start(); return; }
          const rel = ((S.angle - S.zoneStart) % 360 + 360) % 360;
          if (rel < S.zoneSize) {
            // The bright leading edge of the zone is the Great window.
            const great = rel < GREAT_DEG;
            let gain = great ? 14 : 8;
            S.streak++;
            // Every clean streak of 5 banks a bonus charge — rewards steady hands.
            if (great && S.streak % 5 === 0) gain += 4;
            if (great) S.greats++;
            S.progress = Math.min(100, S.progress + gain);
            elStreak.textContent = S.streak;
            elGreat.textContent = S.greats;
            drawProgress();
            flash(great ? 'great' : 'good');
            setStatus(
              great ? `GREAT — +${gain} charge. Streak ${S.streak}.` : `Good hit — +${gain} charge.`,
              great ? 'win' : ''
            );
            if (S.progress >= 100) { win(); return; }
            S.speed = 1.8 + (S.progress / 100) * 2.2;
            newZone();
          } else {
            registerMiss(false);
          }
        }

        function win() {
          cancelAnimationFrame(S.raf);
          S.playing = false;
          const ms = performance.now() - S.startMs;
          if (!bestMs || ms < bestMs) {
            bestMs = Math.round(ms);
            localStorage.setItem(KEY, String(bestMs));
            elBest.textContent = (bestMs / 1000).toFixed(1) + 's';
          }
          elStart.textContent = 'Repair Again';
          wrap.classList.remove('playing');
          setFocus(false);
          setStatus(`Generator powered in ${(ms / 1000).toFixed(1)}s — ${S.greats} greats, ${S.misses} misses.`, 'win');
        }

        elStart.addEventListener('click', (e) => { e.stopPropagation(); if (!S.playing) start(); });
        elReset.addEventListener('click', (e) => { e.stopPropagation(); reset(); });
        svg.addEventListener('click', attemptHit);
        svg.addEventListener('keydown', (e) => {
          if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); attemptHit(); }
        });
        // Space works anywhere while the trainer is on screen
        window.addEventListener('keydown', (e) => {
          if (e.key !== ' ' || e.repeat) return;
          const r = wrap.getBoundingClientRect();
          const onScreen = r.bottom > 0 && r.top < window.innerHeight;
          if (onScreen) { e.preventDefault(); attemptHit(); }
        });

        drawNeedle();
      })();
    </script>
  </body>
</html>
