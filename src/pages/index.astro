            <span class="eyebrow">Killer Dossier</span>
            <h2>Pick your killer.<br/>Read the file.</h2>
          </div>
          <p>Every killer plays different. Switch between three of the District's most wanted — real skills, real perks, real numbers.</p>
        </div>

        <div class="dossier reveal" id="dossierWrap">
          <!-- terror-radius cursor field (decorative) -->
          <div class="threat-field" aria-hidden="true">
            <span class="threat-label" id="threatLabel">Terror Radius · 90 studs</span>
            <span class="heartbeat"></span>
          </div>
          <!-- killer selector -->
          <div class="killer-nav" id="killerNav">
            <button class="killer-tab active" data-killer="veil">
              <span class="glyph">V</span>
              <span>
                <span class="kt-name">The Veil</span>
                <span class="kt-role">Ranged · Original</span>
              </span>
            </button>
            <button class="killer-tab" data-killer="killer">
              <span class="glyph">K</span>
              <span>
                <span class="kt-name">The Killer</span>
                <span class="kt-role">Chase · Frenzy</span>
              </span>
            </button>
            <button class="killer-tab" data-killer="masked">
              <span class="glyph">M</span>
              <span>
                <span class="kt-name">The Masked</span>
                <span class="kt-role">Versatile · Masks</span>
              </span>
            </button>
          </div>

          <!-- detail panel -->
